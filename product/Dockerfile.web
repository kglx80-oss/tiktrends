# --- build (monorepo pnpm) ---
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
# L'empreinte du commit compilé · le contexte de build est `product/`, qui ne
# contient PAS `.git`, et l'image n'a pas git · `next.config.mjs` ne peut donc
# pas la déduire seul (il tombe sur « inconnu »). On la passe en build-arg, et
# `next.config` la préfère à sa tentative git (CDC · Lot 0 · identifier le build).
ARG BUILD_SHA=""
ENV BUILD_SHA=$BUILD_SHA
COPY pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter @tiktrends/web build

# --- run (Next.js standalone) ---
FROM node:22-alpine AS run
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
EXPOSE 3000
# En sortie standalone monorepo, le serveur est apps/web/server.js
CMD ["node", "apps/web/server.js"]
