[Unit]
Description=TikTrends — sauvegarde quotidienne de la base (pg_dump + rotation)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=debian
WorkingDirectory=/home/debian/tiktrends/product
ExecStart=/home/debian/tiktrends/product/ops/backup.sh
