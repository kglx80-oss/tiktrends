# Recette Studios · variables NEUTRALISÉES (valeur vide), versionnées, sans secret.
#
# Chargé APRÈS ops/recette/.env.recette dans chaque service applicatif du
# projet compose `tiktrends-recette` : la dernière définition l'emporte, donc
# même recopiée par erreur dans .env.recette, aucune de ces valeurs n'atteint
# le web, le worker ou les outils de recette. Seul `environment:` du compose
# peut les reposer (FAL_KEY et ANTHROPIC_API_KEY, pour les outils seulement,
# depuis le shell du propriétaire).
#
# Garde : apps/web/test/e-compose-recette.test.ts relit le CODE (toutes les
# variables de stockage et de fournisseurs externes qu'il lit) et échoue si
# l'une d'elles n'est pas neutralisée ici ou dans le compose.

# Stockage objet · la recette garde ses médias en local (ops/recette/sorties).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Fournisseurs IA payants · rien ne part du web ni du worker de recette.
FAL_KEY=
ANTHROPIC_API_KEY=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# Tâches planifiées · routes /api/cron/* fermées (503), déclencheurs du worker muets.
CRON_SECRET=

# Services externes · aucune synchro, aucun envoi, aucun paiement depuis la recette.
TRENDTRACK_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
KLAVIYO_API_KEY=
SLACK_BOT_TOKEN=
SMTP_URL=
META_APP_ID=
META_APP_SECRET=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
GOOGLE_API_KEY=
GOOGLE_APP_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_APP_ID=
STUDIO_WEBHOOK_SECRET=
