# Copie en .env.deploy sur le VPS (ne pas committer).
POSTGRES_PASSWORD=change-me-strong
DATABASE_URL=postgres://tiktrends:change-me-strong@db:5432/tiktrends
REDIS_URL=redis://redis:6379
AUTH_SECRET=change-me
APP_URL=https://app.tiktrends.co
# Inscription : self-service ouverte par défaut (chacun crée son espace, essai inclus).
# Mets SIGNUP_OPEN=false pour repasser en accès sur invitation uniquement.
SIGNUP_OPEN=true
# Stockage objet : OVH Object Storage (S3-compatible) · upload direct des gros fichiers (Assets)
# Prérequis bucket : lecture publique des objets + CORS autorisant PUT depuis APP_URL.
S3_ENDPOINT=s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=tiktrends-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optionnel : base publique/CDN de lecture (défaut https://{S3_ENDPOINT}/{S3_BUCKET})
S3_PUBLIC_BASE_URL=
# IA + plateformes (voir .env.example)
ANTHROPIC_API_KEY=
# Génération d'images (Pubs IA historique ET Studios) · même clé fal pour les deux.
FAL_KEY=
# Studios · interrupteurs de capacités (ops/README.md, « Interrupteurs Studios »).
# Listes séparées par des virgules ; vides = défauts du code (capacités payantes coupées).
# Préférer l'écran /admin/studios-interrupteurs pour un espace pilote (sans redémarrage).
# STUDIOS_CAPACITES_COUPEES=
# STUDIOS_CAPACITES_GENERALES=
# STUDIOS_ESPACES_PILOTES=
# STUDIOS_CAPACITES_PILOTES=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Meta : app Facebook (OAuth « en un clic »). Redirect URI à déclarer dans l'app :
#   {APP_URL}/api/oauth/meta/callback   (ex : https://app.tiktrends.co/api/oauth/meta/callback)
META_APP_ID=
META_APP_SECRET=
# Chiffrement des tokens stockés (Shopify/Meta). Défaut : AUTH_SECRET. Recommandé : une clé dédiée.
TOKEN_ENC_KEY=
TRENDTRACK_API_KEY=
# Shopify : app (Partner) pour l'OAuth « en un clic ». Redirect URI à déclarer :
#   {APP_URL}/api/oauth/shopify/callback
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Google Drive : connexion automatique d'un dossier (synchro assets). OAuth client « Web ».
# Modèle drive.file (comme Atria) : scope NON sensible, AUCUNE vérification Google requise,
# chaque client se connecte en 1 clic. L'utilisateur choisit son dossier via le sélecteur Google (Picker).
# Redirect URI à déclarer dans la console Google Cloud :
#   {APP_URL}/api/oauth/google/callback   (ex : https://app.tiktrends.co/api/oauth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sélecteur Google (Picker) : clé API (API et services > Identifiants > Clé API, restreinte à l'API Picker)
# + numéro du projet Google Cloud (Paramètres du projet > Numéro du projet).
GOOGLE_API_KEY=
GOOGLE_APP_ID=
# Clé secrète Stripe (sk_…) · sans elle, /billing dit « paiement pas encore disponible ».
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_…), endpoint {APP_URL}/api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# Prix Stripe des formules · un identifiant de PRIX « price_… » (fiche du produit
# dans Stripe), JAMAIS un lien « buy.stripe.com » : un paiement par lien n'a pas
# la formule dans ses métadonnées et le webhook ne créditerait pas le client.
# Abonnement mensuel récurrent en EUR, au montant de la formule (Core).
STRIPE_PRICE_CORE=
# Identifiant « price_… » de la formule Plus (récurrent mensuel, EUR).
STRIPE_PRICE_PLUS=
# Identifiant « price_… » de la formule Business (récurrent mensuel, EUR).
STRIPE_PRICE_BUSINESS=
# --- Offre V2 (Essentiel / Pro / Agence) · servie seulement quand TARIFS_V2=1 ---
# Interrupteur · absent = l'offre d'aujourd'hui, inchangée. À poser APRÈS avoir
# créé les prix V2 dans Stripe (docs/FACTURATION-STRIPE.md).
TARIFS_V2=
# Six prix récurrents EUR, taxe INCLUSE (TTC), un identifiant « price_… » chacun.
STRIPE_PRICE_ESSENTIEL_MENSUEL=
STRIPE_PRICE_ESSENTIEL_ANNUEL=
STRIPE_PRICE_PRO_MENSUEL=
STRIPE_PRICE_PRO_ANNUEL=
STRIPE_PRICE_AGENCE_MENSUEL=
STRIPE_PRICE_AGENCE_ANNUEL=
# Recharges V2 · FACULTATIF · un « price_… » ponctuel EUR taxe incluse par forfait
# et par pack (2 000, 5 000, 15 000 crédits). Vide = prix en ligne TTC calculé
# par l'appli au bon montant, rien à créer dans Stripe.
STRIPE_PRICE_RECHARGE_ESSENTIEL_2000=
STRIPE_PRICE_RECHARGE_ESSENTIEL_5000=
STRIPE_PRICE_RECHARGE_ESSENTIEL_15000=
STRIPE_PRICE_RECHARGE_PRO_2000=
STRIPE_PRICE_RECHARGE_PRO_5000=
STRIPE_PRICE_RECHARGE_PRO_15000=
STRIPE_PRICE_RECHARGE_AGENCE_2000=
STRIPE_PRICE_RECHARGE_AGENCE_5000=
STRIPE_PRICE_RECHARGE_AGENCE_15000=
