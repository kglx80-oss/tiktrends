# Copie en .env.deploy sur le VPS (ne pas committer).
POSTGRES_PASSWORD=change-me-strong
DATABASE_URL=postgres://tiktrends:change-me-strong@db:5432/tiktrends
REDIS_URL=redis://redis:6379
AUTH_SECRET=change-me
APP_URL=https://app.tiktrends.co
# Stockage : OVH Object Storage (S3-compatible)
R2_ACCOUNT_ID=ovh
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tiktrends-media
S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
# IA + plateformes (voir .env.example)
ANTHROPIC_API_KEY=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
META_APP_ID=
META_APP_SECRET=
TRENDTRACK_API_KEY=
STRIPE_SECRET_KEY=
