# Copie en .env.deploy sur le VPS (ne pas committer).
POSTGRES_PASSWORD=change-me-strong
DATABASE_URL=postgres://tiktrends:change-me-strong@db:5432/tiktrends
REDIS_URL=redis://redis:6379
AUTH_SECRET=change-me
APP_URL=https://app.tiktrends.co
# Inscription : self-service ouverte par défaut (chacun crée son espace, essai inclus).
# Mets SIGNUP_OPEN=false pour repasser en accès sur invitation uniquement.
SIGNUP_OPEN=true
# Stockage objet : OVH Object Storage (S3-compatible) · upload direct des gros fichiers (Assets)
# Prérequis bucket : lecture publique des objets + CORS autorisant PUT depuis APP_URL.
S3_ENDPOINT=s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=tiktrends-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optionnel : base publique/CDN de lecture (défaut https://{S3_ENDPOINT}/{S3_BUCKET})
S3_PUBLIC_BASE_URL=
# IA + plateformes (voir .env.example)
ANTHROPIC_API_KEY=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Meta : app Facebook (OAuth « en un clic »). Redirect URI à déclarer dans l'app :
#   {APP_URL}/api/oauth/meta/callback   (ex : https://app.tiktrends.co/api/oauth/meta/callback)
META_APP_ID=
META_APP_SECRET=
# Chiffrement des tokens stockés (Shopify/Meta). Défaut : AUTH_SECRET. Recommandé : une clé dédiée.
TOKEN_ENC_KEY=
TRENDTRACK_API_KEY=
# Shopify : app (Partner) pour l'OAuth « en un clic ». Redirect URI à déclarer :
#   {APP_URL}/api/oauth/shopify/callback
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Google Drive : connexion automatique d'un dossier (synchro assets). OAuth client « Web ».
# Modèle drive.file (comme Atria) : scope NON sensible, AUCUNE vérification Google requise,
# chaque client se connecte en 1 clic. L'utilisateur choisit son dossier via le sélecteur Google (Picker).
# Redirect URI à déclarer dans la console Google Cloud :
#   {APP_URL}/api/oauth/google/callback   (ex : https://app.tiktrends.co/api/oauth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sélecteur Google (Picker) : clé API (API et services > Identifiants > Clé API, restreinte à l'API Picker)
# + numéro du projet Google Cloud (Paramètres du projet > Numéro du projet).
GOOGLE_API_KEY=
GOOGLE_APP_ID=
STRIPE_SECRET_KEY=
