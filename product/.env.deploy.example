# Copie en .env.deploy sur le VPS (ne pas committer).
POSTGRES_PASSWORD=change-me-strong
DATABASE_URL=postgres://tiktrends:change-me-strong@db:5432/tiktrends
REDIS_URL=redis://redis:6379
AUTH_SECRET=change-me
APP_URL=https://app.tiktrends.co
# Clé des passages planifiés (worker → routes /api/cron/*) · une chaîne aléatoire
# longue, la même pour le web et le worker (ce fichier sert aux deux).
# ABSENTE : ni la remontée Meta, ni le radar, ni le suivi des concurrents, ni le
# récap hebdo, ni les allocations, ni la bascule des forfaits, ni le suivi des
# vidéos historiques ne partent. Les routes répondent 503 et seul
# le journal du worker le dit (« CRON_SECRET absent · passage non déclenché »).
# Visible dans Réglages → Espace → « Exploitation de la plateforme ».
CRON_SECRET=
# Plafond dur de dépense IA en dollars, 30 jours glissants, web + worker.
# ABSENT, vide ou illisible : repli SILENCIEUX sur la valeur par défaut du code
# (spend-guard.ts, DEFAULT_CAP_USD). La valeur effective et sa source
# (« défini » ou « valeur par défaut ») s'affichent dans Réglages → Espace.
AI_SPEND_CAP_USD=
# Inscription : self-service ouverte par défaut (chacun crée son espace, essai inclus).
# Mets SIGNUP_OPEN=false pour repasser en accès sur invitation uniquement.
SIGNUP_OPEN=true
# Stockage objet : OVH Object Storage (S3-compatible) · upload direct des gros fichiers (Assets)
# Prérequis bucket : objets PRIVÉS (l'appli lit par liens signés · ne jamais rendre
# le bucket public) + CORS autorisant PUT depuis APP_URL (bouton « Configurer le
# stockage privé (CORS) » dans Réglages → Espace).
S3_ENDPOINT=s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=tiktrends-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optionnel : base publique/CDN de lecture (défaut https://{S3_ENDPOINT}/{S3_BUCKET})
S3_PUBLIC_BASE_URL=
# IA + plateformes (voir .env.example)
# ABSENTE : rédaction, assistant, pré-remplissage de marque et analyse concurrent
# indisponibles (visible : « À brancher » dans Réglages → Espace → Services activés).
ANTHROPIC_API_KEY=
# Optionnel · modèle de rédaction. Laisser commenté : le défaut du code s'applique.
# ANTHROPIC_GEN_MODEL=
# Génération d'images (Pubs IA historique ET Studios) · même clé fal pour les deux.
FAL_KEY=
# Modèles fal · optionnels. Laisser commentés : les défauts du code s'appliquent.
# Studios · génération d'image sans référence.
# FAL_IMAGE_MODEL=
# Studios · mise en scène produit (édition d'image avec référence).
# FAL_IMAGE_MODEL_EDIT=
# Studios · animation des plans, choisi dans le catalogue chiffré
# (packages/core/src/studios/fournisseurs/catalogue-video.ts) · absent = Kling 2.5 turbo pro ;
# un modèle hors catalogue est refusé au devis.
# FAL_VIDEO_MODEL_STUDIO=
# Ancien « Vidéo IA » seulement · ne pilote PAS les Studios (le worker le signale
# au démarrage si elle est posée sans FAL_VIDEO_MODEL_STUDIO).
# FAL_VIDEO_MODEL_I2V=
# Ancien moteur vidéo · seulement le suivi des vidéos historiques encore en cours.
# Absente : « À brancher » dans Services activés, rien d'autre ne change.
# HIGGSFIELD_API_KEY=
# Studios · interrupteurs de capacités (ops/README.md, « Interrupteurs Studios »).
# Listes séparées par des virgules ; vides = défauts du code. Capacités COUPÉES par
# défaut : generation_image, controle_visuel, video, voix, shadow, benchmark_reel.
# Préférer l'écran /admin/studios-interrupteurs pour un espace pilote (sans redémarrage).
# L'état de chaque capacité s'affiche dans Réglages → Espace (équipe de la plateforme).
# Coupure d'urgence, partout · vide : rien n'est coupé en plus des défauts.
STUDIOS_CAPACITES_COUPEES=
# Généralisation, tous les espaces (ex. generation_image,video).
# VIDE : les capacités ci-dessus restent coupées partout, sauf espace pilote.
STUDIOS_CAPACITES_GENERALES=
# Espaces pilotes (identifiants d'espace) · ne sert qu'avec STUDIOS_CAPACITES_PILOTES.
STUDIOS_ESPACES_PILOTES=
# Capacités ouvertes aux seuls espaces pilotes (ex. generation_image).
# VIDE : aucun espace pilote n'a de capacité par l'environnement (l'écran ADMIN reste possible).
STUDIOS_CAPACITES_PILOTES=
# Sans version des consignes publiée (/admin/prompts/registre, onglet Releases),
# toute tâche IA des Studios est refusée, quelles que soient ces variables.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Meta : app Facebook (OAuth « en un clic »). Redirect URI à déclarer dans l'app :
#   {APP_URL}/api/oauth/meta/callback   (ex : https://app.tiktrends.co/api/oauth/meta/callback)
META_APP_ID=
META_APP_SECRET=
# Chiffrement des tokens stockés (Shopify/Meta). Défaut : AUTH_SECRET. Recommandé : une clé dédiée.
TOKEN_ENC_KEY=
TRENDTRACK_API_KEY=
# Courriels (bienvenue, invitation, réinitialisation, récap hebdo) · smtp://utilisateur:motdepasse@hote:587
# ABSENTE : chaque courriel est sauté en SILENCE (une ligne [mail:skip] au journal web),
# le récap hebdo répond 503 smtp_absent. Visible : « À brancher » dans Services activés.
SMTP_URL=
# Optionnel · expéditeur. Laisser commenté : le défaut du code s'applique.
# MAIL_FROM=
# E-mails marketing (profils et flows) · ABSENTE : chaque événement est sauté ([klaviyo:skip]).
KLAVIYO_API_KEY=
# Messagerie d'équipe (à venir) · absente : « À brancher » dans Services activés.
# SLACK_BOT_TOKEN=
# Shopify : app (Partner) pour l'OAuth « en un clic ». Redirect URI à déclarer :
#   {APP_URL}/api/oauth/shopify/callback
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Google Drive : connexion automatique d'un dossier (synchro assets). OAuth client « Web ».
# Modèle drive.file (comme Atria) : scope NON sensible, AUCUNE vérification Google requise,
# chaque client se connecte en 1 clic. L'utilisateur choisit son dossier via le sélecteur Google (Picker).
# Redirect URI à déclarer dans la console Google Cloud :
#   {APP_URL}/api/oauth/google/callback   (ex : https://app.tiktrends.co/api/oauth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sélecteur Google (Picker) : clé API (API et services > Identifiants > Clé API, restreinte à l'API Picker)
# + numéro du projet Google Cloud (Paramètres du projet > Numéro du projet).
GOOGLE_API_KEY=
GOOGLE_APP_ID=
# Clé secrète Stripe (sk_…) · sans elle, /billing dit « paiement pas encore disponible ».
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_…), endpoint {APP_URL}/api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# Prix Stripe des formules · un identifiant de PRIX « price_… » (fiche du produit
# dans Stripe), JAMAIS un lien « buy.stripe.com » : un paiement par lien n'a pas
# la formule dans ses métadonnées et le webhook ne créditerait pas le client.
# Abonnement mensuel récurrent en EUR, au montant de la formule (Core).
STRIPE_PRICE_CORE=
# Identifiant « price_… » de la formule Plus (récurrent mensuel, EUR).
STRIPE_PRICE_PLUS=
# Identifiant « price_… » de la formule Business (récurrent mensuel, EUR).
STRIPE_PRICE_BUSINESS=
# --- Offre V2 (Essentiel / Pro / Agence) · servie seulement quand TARIFS_V2=1 ---
# Interrupteur · absent = l'offre d'aujourd'hui, inchangée. À poser APRÈS avoir
# créé les prix V2 dans Stripe (docs/FACTURATION-STRIPE.md).
TARIFS_V2=
# Six prix récurrents EUR, taxe INCLUSE (TTC), un identifiant « price_… » chacun.
STRIPE_PRICE_ESSENTIEL_MENSUEL=
STRIPE_PRICE_ESSENTIEL_ANNUEL=
STRIPE_PRICE_PRO_MENSUEL=
STRIPE_PRICE_PRO_ANNUEL=
STRIPE_PRICE_AGENCE_MENSUEL=
STRIPE_PRICE_AGENCE_ANNUEL=
# Recharges V2 · FACULTATIF · un « price_… » ponctuel EUR taxe incluse par forfait
# et par pack (2 000, 5 000, 15 000 crédits). Vide = prix en ligne TTC calculé
# par l'appli au bon montant, rien à créer dans Stripe.
STRIPE_PRICE_RECHARGE_ESSENTIEL_2000=
STRIPE_PRICE_RECHARGE_ESSENTIEL_5000=
STRIPE_PRICE_RECHARGE_ESSENTIEL_15000=
STRIPE_PRICE_RECHARGE_PRO_2000=
STRIPE_PRICE_RECHARGE_PRO_5000=
STRIPE_PRICE_RECHARGE_PRO_15000=
STRIPE_PRICE_RECHARGE_AGENCE_2000=
STRIPE_PRICE_RECHARGE_AGENCE_5000=
STRIPE_PRICE_RECHARGE_AGENCE_15000=
