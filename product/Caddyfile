# DNS : enregistrement A  app.tiktrends.co  ->  IP du VPS OVH (51.255.39.79)
# TLS Let's Encrypt automatique (Caddy gère le certificat + le renouvellement).
app.tiktrends.co {
	reverse_proxy web:3000
}

# Accès direct par IP en HTTP (utile avant propagation DNS / pour un test rapide).
