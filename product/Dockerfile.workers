FROM node:22-alpine AS build
RUN corepack enable
# Studios L7-B · décodage vidéo RÉEL des sorties (ffprobe PUIS ffmpeg, toutes
# les images). Paquet `ffmpeg` du dépôt community d'Alpine (ffmpeg et ffprobe).
# Aucune capacité n'est promise par cette ligne : au démarrage, le worker sonde
# ffmpeg (version, encodeurs, échantillon généré puis décodé) et ne publie la
# capacité vidéo que si l'échantillon est lu en entier.
RUN apk add --no-cache ffmpeg
WORKDIR /app
COPY pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --no-frozen-lockfile
# Le commit construit, dans l'environnement du worker et du conteneur de
# migration (`printenv BUILD_SHA`). Après l'installation : il change à chaque
# commit et n'invalide ainsi ni `apk add` ni `pnpm install`. Aucun code ne le lit.
ARG BUILD_SHA=""
ENV BUILD_SHA=$BUILD_SHA
WORKDIR /app/apps/workers
# Arrêt propre · le processus 1 doit ATTENDRE son enfant sur SIGTERM (le worker
# finit son tour, une soumission partie écrit sa requête). Mesuré le 16/11 :
# `pnpm start` relaie le signal mais sort aussitôt (ELIFECYCLE), l'enfant est
# tué ; `pnpm exec tsx` attend. Même point d'entrée que le script `start`.
# Garde : apps/workers/test/studios-arret-worker.test.ts.
CMD ["pnpm", "exec", "tsx", "src/index.ts"]
