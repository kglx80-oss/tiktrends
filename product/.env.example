# --- Base ---
DATABASE_URL=
DIRECT_URL=
REDIS_URL=
# --- Auth ---
AUTH_SECRET=
# --- Stockage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# --- IA ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
FAL_KEY=
# Fal — modèles image (options, voir docs/CLES-A-BRANCHER.md) :
FAL_IMAGE_MODEL=
FAL_IMAGE_MODEL_I2I=
FAL_IMAGE_MODEL_TEXT=
FAL_IMAGE_MODEL_EDIT=
# Fal — modèles vidéo (Kling 2 par défaut) :
FAL_VIDEO_MODEL=
FAL_VIDEO_MODEL_I2V=
FAL_QUEUE_URL=
# Studios · worker (lot F-A, docs/studios-v2/F-FOURNISSEUR-IMAGE.md) :
# fournisseur fal RÉEL hors production seulement si cette variable vaut « autorise »
# (en production, FAL_KEY réelle + S3_* suffisent). Laisser vide en local.
STUDIO_FOURNISSEUR_REEL=
# Secret HMAC des webhooks studio (x-studio-signature) · posé par le propriétaire
# dans .env.deploy ; inutilisé tant qu'aucune route webhook n'est branchée (fal est sondé).
STUDIO_WEBHOOK_SECRET=
# Plafond dur de dépense IA, 30 jours glissants, partagé web + worker (défaut 50 $).
AI_SPEND_CAP_USD=
# Stockage objet S3 (résultats des studios, déposés puis relus par le worker) :
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
GEMINI_API_KEY=
HIGGSFIELD_API_KEY=
# Higgsfield (options — voir docs/CLES-A-BRANCHER.md) :
HIGGSFIELD_API_SECRET=
HIGGSFIELD_BASE_URL=
HIGGSFIELD_T2V_PATH=
HIGGSFIELD_I2V_PATH=
HIGGSFIELD_JOB_PATH=
HIGGSFIELD_MODEL=
WHISPER_API_KEY=
# --- Plateformes publicitaires ---
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
META_APP_ID=
META_APP_SECRET=
META_AD_LIBRARY_TOKEN=
# --- Data ---
TRENDTRACK_API_KEY=
# --- E-mail (notifications) ---
SMTP_URL=
# --- Intégrations ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
NOTION_API_KEY=
# Clé secrète Stripe (sk_…) · sans elle, /billing dit « paiement pas encore disponible ».
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_…), endpoint {APP_URL}/api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# Prix Stripe des formules · un identifiant de PRIX « price_… » (fiche du produit
# dans Stripe), JAMAIS un lien « buy.stripe.com » : un paiement par lien n'a pas
# la formule dans ses métadonnées et le webhook ne créditerait pas le client.
# Abonnement mensuel récurrent en EUR, au montant de la formule (Core).
STRIPE_PRICE_CORE=
# Identifiant « price_… » de la formule Plus (récurrent mensuel, EUR).
STRIPE_PRICE_PLUS=
# Identifiant « price_… » de la formule Business (récurrent mensuel, EUR).
STRIPE_PRICE_BUSINESS=
# --- Offre V2 (Essentiel / Pro / Agence) · servie seulement quand TARIFS_V2=1 ---
# Interrupteur · absent = l'offre d'aujourd'hui, inchangée. À poser APRÈS avoir
# créé les prix V2 dans Stripe (docs/FACTURATION-STRIPE.md).
TARIFS_V2=
# Six prix récurrents EUR, taxe INCLUSE (TTC), un identifiant « price_… » chacun.
STRIPE_PRICE_ESSENTIEL_MENSUEL=
STRIPE_PRICE_ESSENTIEL_ANNUEL=
STRIPE_PRICE_PRO_MENSUEL=
STRIPE_PRICE_PRO_ANNUEL=
STRIPE_PRICE_AGENCE_MENSUEL=
STRIPE_PRICE_AGENCE_ANNUEL=
# Recharges V2 · FACULTATIF · un « price_… » ponctuel EUR taxe incluse par forfait
# et par pack (2 000, 5 000, 15 000 crédits). Vide = prix en ligne TTC calculé
# par l'appli au bon montant, rien à créer dans Stripe.
STRIPE_PRICE_RECHARGE_ESSENTIEL_2000=
STRIPE_PRICE_RECHARGE_ESSENTIEL_5000=
STRIPE_PRICE_RECHARGE_ESSENTIEL_15000=
STRIPE_PRICE_RECHARGE_PRO_2000=
STRIPE_PRICE_RECHARGE_PRO_5000=
STRIPE_PRICE_RECHARGE_PRO_15000=
STRIPE_PRICE_RECHARGE_AGENCE_2000=
STRIPE_PRICE_RECHARGE_AGENCE_5000=
STRIPE_PRICE_RECHARGE_AGENCE_15000=
APIFY_TOKEN=
# --- Plateforme / ADMIN+ ---
# E-mails fondateurs (séparés par virgule) autorisés à voir la vue plateforme
# (MRR, churn, tous les espaces). Sans valeur : personne n'y a accès.
FOUNDER_EMAILS=
# --- Observabilité ---
SENTRY_DSN=
